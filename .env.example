# GitHub Self-Hosted Runner Configuration
# Copy this file to .env and fill in your values

# Required: Your GitHub organization or repository URL
# For organization: https://github.com/your-org
# For repository: https://github.com/your-org/your-repo
GITHUB_URL=https://github.com/your-org

# Required: GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes:
#   - For organization runners: admin:org
#   - For repository runners: repo
GITHUB_TOKEN=your_github_personal_access_token

# Optional: Custom runner name (defaults to container hostname)
RUNNER_NAME=my-docker-runner

# Optional: Custom labels (comma-separated, defaults to "self-hosted,Linux,X64")
RUNNER_LABELS=self-hosted,Linux,X64,docker

# Optional: Runner group (defaults to "Default")
RUNNER_GROUP=Default

# Optional: Working directory (defaults to "_work")
RUNNER_WORKDIR=_work
