FROM ubuntu:22.04

# Avoid prompts from apt
ENV DEBIAN_FRONTEND=noninteractive

# Set GitHub runner version (can be overridden at build time)
ARG RUNNER_VERSION=2.321.0
ARG TARGETARCH=x64

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    git \
    jq \
    build-essential \
    libssl-dev \
    libffi-dev \
    python3 \
    python3-venv \
    python3-dev \
    python3-pip \
    apt-transport-https \
    ca-certificates \
    software-properties-common \
    sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create a user for the runner
RUN useradd -m -s /bin/bash runner && \
    usermod -aG sudo runner && \
    echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Set up working directory
WORKDIR /home/runner

# Download and extract GitHub Actions runner
RUN wget --no-check-certificate \
    https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${TARGETARCH}-${RUNNER_VERSION}.tar.gz && \
    tar xzf ./actions-runner-linux-${TARGETARCH}-${RUNNER_VERSION}.tar.gz && \
    rm actions-runner-linux-${TARGETARCH}-${RUNNER_VERSION}.tar.gz && \
    chown -R runner:runner /home/runner

# Install runner dependencies
RUN ./bin/installdependencies.sh

# Copy the start script
COPY start-runner.sh /home/runner/start-runner.sh
RUN chmod +x /home/runner/start-runner.sh && \
    chown runner:runner /home/runner/start-runner.sh

# Switch to the runner user
USER runner

# Set the entrypoint to the start script
ENTRYPOINT ["/home/runner/start-runner.sh"]
